{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FeatureType Volar: build extension",
      "type": "shell",
      "command": "pnpm --filter featuretype-language-features build",
      "group": "build",
      "problemMatcher": {
        "pattern": {
          "regexp": "__________"
        }
      }
    },
    {
      "label": "FeatureType Volar: watch extension",
      "type": "shell",
      "command": "pnpm --filter featuretype-language-features watch",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "__________"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "watching\\.\\.\\."
        }
      }
    },
    {
      "label": "FeatureType Volar: verify",
      "type": "shell",
      "command": "pnpm run verify:volar",
      "group": "test",
      "problemMatcher": {
        "pattern": {
          "regexp": "__________"
        }
      }
    }
  ]
}
