{
  "name": "@type-atlas/atlascii",
  "version": "0.6.1",
  "description": "ASCII components for code intelligence: locations, navigation targets, call hierarchies, outlines, diagnostics, and source frames as plain text.",
  "keywords": [
    "ascii",
    "code-intelligence",
    "language-server",
    "lsp",
    "terminal",
    "text"
  ],
  "homepage": "https://github.com/tyler-mitchell/type-atlas/tree/main/atlascii",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/type-atlas/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/type-atlas.git",
    "directory": "atlascii"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "development": "./src/document/index.ts",
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./document": {
        "types": "./dist/document/index.d.ts",
        "import": "./dist/document/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/document/index.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepack": "vp run build",
    "test": "vp test run"
  },
  "dependencies": {
    "messageformat": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@markdoc/markdoc": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@markdoc/markdoc": "*"
  },
  "peerDependenciesMeta": {
    "@markdoc/markdoc": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20"
  }
}
