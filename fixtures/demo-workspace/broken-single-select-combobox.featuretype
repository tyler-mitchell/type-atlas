# Broken Single Select Combobox

```tsx
// ./broken-single-select-combobox.example.tsx
import { useState } from "react"
import { SingleSelectCombobox } from "./components"

export function BrokenControlledCombobox() {
  const [value, setValue] = useState("updated-desc")
  return (
    <SingleSelectCombobox
      ariaLabel="Sort repos"
      placeholder="Sort"
      selectedValue={value}
      onValueChange={setValue}
      options={[
        { label: "Recently updated", value: "updated-desc" },
        { label: "Name A-Z", value: "name-asc" },
      ]}
    />
  )
}
```
