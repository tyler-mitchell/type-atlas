{
  "name": "@featuretype/code-intelligence",
  "version": "0.0.0",
  "description": "Headless Volar-based language intelligence for coding agents.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/featuretype.git",
    "directory": "packages/code-intelligence"
  },
  "bugs": {
    "url": "https://github.com/tyler-mitchell/featuretype/issues"
  },
  "homepage": "https://github.com/tyler-mitchell/featuretype/tree/main/packages/code-intelligence",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./text": {
      "development": "./src/plain-text.ts",
      "types": "./dist/plain-text.d.ts",
      "import": "./dist/plain-text.js"
    },
    "./folded-source": {
      "development": "./src/folded-source.ts",
      "types": "./dist/folded-source.d.ts",
      "import": "./dist/folded-source.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/plain-text.ts src/folded-source.ts --format esm --dts --clean --outDir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@volar/language-server": "2.4.28",
    "chokidar": "^3.6.0",
    "pathe": "^2.0.3",
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "5.9.3"
  }
}
