{
  "name": "@featuretype/code-intelligence-language-server",
  "version": "0.0.0",
  "description": "Volar language server for TypeScript, Markdown, and JSON code intelligence.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/featuretype.git",
    "directory": "packages/code-intelligence-language-server"
  },
  "bugs": {
    "url": "https://github.com/tyler-mitchell/featuretype/issues"
  },
  "homepage": "https://github.com/tyler-mitchell/featuretype#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "code-intelligence-language-server": "./bin/code-intelligence-language-server.cjs"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./protocol": {
      "development": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/protocol.ts --format esm --dts --clean --outDir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@volar/language-server": "2.4.28",
    "typescript": "5.9.3",
    "volar-service-json": "0.0.71",
    "volar-service-markdown": "0.0.71",
    "volar-service-typescript": "0.0.71",
    "vscode-markdown-languageservice": "0.5.0-alpha.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@volar/test-utils": "2.4.28",
    "vitest": "^2.1.8",
    "vscode-uri": "^3.0.8"
  }
}
