{
  "name": "@typeatlas/mcp",
  "version": "0.0.0",
  "description": "Editor-grade TypeScript, Markdown, and JSON intelligence for coding agents.",
  "keywords": [
    "code-intelligence",
    "coding-agents",
    "json",
    "language-server",
    "lsp",
    "markdown",
    "mcp",
    "model-context-protocol",
    "typeatlas",
    "typescript",
    "volar"
  ],
  "homepage": "https://github.com/tyler-mitchell/typeatlas/tree/main/packages/mcp",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/typeatlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/typeatlas.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "typeatlas": "./bin/typeatlas.cjs"
  },
  "files": [
    "assets",
    "bin",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./bin/typeatlas.cjs",
    "./dist/cli.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "node --conditions=development src/cli.ts",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@typeatlas/core": "workspace:*",
    "@typeatlas/language-server": "workspace:*",
    "@volar/language-server": "catalog:",
    "arktype": "catalog:",
    "citty": "catalog:",
    "diff": "catalog:",
    "fdir": "catalog:",
    "globby": "catalog:",
    "pathe": "catalog:",
    "picomatch": "catalog:",
    "vscode-languageserver-protocol": "catalog:",
    "vscode-languageserver-textdocument": "catalog:",
    "vscode-uri": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  }
}
