{
  "name": "@type-atlas/mcp",
  "version": "0.6.1",
  "description": "Editor-grade TypeScript, Markdown, and JSON intelligence for coding agents.",
  "keywords": [
    "code-intelligence",
    "coding-agents",
    "json",
    "language-server",
    "lsp",
    "markdown",
    "mcp",
    "model-context-protocol",
    "type-atlas",
    "typescript",
    "volar"
  ],
  "homepage": "https://github.com/tyler-mitchell/type-atlas#readme",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/type-atlas/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/type-atlas.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "type-atlas": "./bin/type-atlas.cjs"
  },
  "files": [
    "assets",
    "bin",
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./bin/type-atlas.cjs",
    "./dist/cli.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "accept": "vp test run -u --project=scenarios -t",
    "build": "vp pack src/index.ts src/cli.ts",
    "capture": "vp test run -u --project=unit --project=scenarios --project=docs",
    "case": "vp test --project=scenarios -t",
    "case:run": "vp test run --project=scenarios -t",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "node --conditions=development src/cli.ts",
    "prepack": "vp run build",
    "test": "vp test run --project=unit --project=scenarios --project=docs",
    "test:unit": "vp test run --project=unit",
    "test:determinism": "vp test run --project=determinism",
    "test:scenarios": "vp test run --project=scenarios"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@type-atlas/atlascii": "workspace:*",
    "@type-atlas/core": "workspace:*",
    "@type-atlas/language-server": "workspace:*",
    "@volar/language-server": "catalog:",
    "arktype": "catalog:",
    "citty": "catalog:",
    "diff": "catalog:",
    "fdir": "catalog:",
    "globby": "catalog:",
    "pathe": "catalog:",
    "picomatch": "catalog:",
    "vscode-languageserver-protocol": "catalog:",
    "vscode-languageserver-textdocument": "catalog:",
    "vscode-uri": "catalog:"
  },
  "devDependencies": {
    "@markdoc/markdoc": "catalog:",
    "@types/node": "catalog:",
    "execa": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  },
  "mcpName": "io.github.tyler-mitchell/type-atlas"
}
