{
  "name": "@featuretype/code-intelligence-mcp",
  "version": "0.0.0",
  "description": "Editor-grade code intelligence for coding agents, powered by Volar.js.",
  "keywords": [
    "code-intelligence",
    "json",
    "language-server",
    "markdown",
    "mcp",
    "typescript",
    "volar"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/featuretype.git",
    "directory": "packages/code-intelligence-mcp"
  },
  "bugs": {
    "url": "https://github.com/tyler-mitchell/featuretype/issues"
  },
  "homepage": "https://github.com/tyler-mitchell/featuretype/tree/main/packages/code-intelligence-mcp",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "code-intelligence-mcp": "./bin/code-intelligence-mcp.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --outDir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "node --conditions=development src/cli.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@featuretype/code-intelligence": "workspace:*",
    "@featuretype/code-intelligence-language-server": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "@volar/language-server": "2.4.28",
    "arktype": "^2.2.3",
    "citty": "^0.2.2",
    "diff": "^7.0.0",
    "pathe": "^2.0.3",
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.10",
    "typescript": "5.9.3"
  }
}
