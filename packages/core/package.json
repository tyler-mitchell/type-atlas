{
  "name": "@type-atlas/core",
  "version": "0.4.1",
  "description": "Headless TypeScript, Markdown, and JSON code intelligence powered by Volar.js.",
  "keywords": [
    "code-intelligence",
    "json",
    "language-server",
    "markdown",
    "typescript",
    "volar"
  ],
  "homepage": "https://github.com/tyler-mitchell/type-atlas/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/type-atlas/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/type-atlas.git",
    "directory": "packages/core"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepack": "vp run build",
    "test": "vp test run"
  },
  "dependencies": {
    "@markdoc/markdoc": "catalog:",
    "@type-atlas/atlascii": "workspace:*",
    "@type-atlas/language-server": "workspace:*",
    "@volar/language-server": "catalog:",
    "chokidar": "catalog:",
    "pathe": "catalog:",
    "pkg-types": "catalog:",
    "typescript": "catalog:",
    "volar-service-typescript": "catalog:",
    "vscode-languageserver-protocol": "catalog:",
    "vscode-languageserver-textdocument": "catalog:",
    "vscode-uri": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  }
}
