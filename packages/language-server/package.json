{
  "name": "@featuretype/language-server",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "featuretype-language-server": "./bin/featuretype-language-server.cjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs --dts --outDir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@featuretype/service": "workspace:*",
    "@volar/language-server": "2.4.28",
    "volar-service-typescript": "0.0.65",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@volar/test-utils": "2.4.28"
  }
}
