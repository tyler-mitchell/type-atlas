{
  "name": "@type-atlas/language-server",
  "version": "1.0.0",
  "description": "Volar-based TypeScript, Markdown, and JSON language server for Type Atlas.",
  "keywords": [
    "json",
    "language-server",
    "lsp",
    "markdown",
    "typescript",
    "volar"
  ],
  "homepage": "https://github.com/tyler-mitchell/type-atlas/tree/main/packages/language-server",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/type-atlas/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/type-atlas.git",
    "directory": "packages/language-server"
  },
  "bin": {
    "type-atlas-language-server": "./bin/type-atlas-language-server.cjs"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./bin/type-atlas-language-server.cjs",
    "./dist/node.js",
    "./src/node.ts"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./protocol": {
      "development": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "default": "./dist/node.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "import": "./dist/protocol.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/node.ts src/protocol.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@volar/language-server": "catalog:",
    "typescript": "catalog:",
    "volar-service-json": "catalog:",
    "volar-service-markdown": "catalog:",
    "volar-service-typescript": "catalog:",
    "vscode-markdown-languageservice": "catalog:",
    "vscode-uri": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@volar/test-utils": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  }
}
