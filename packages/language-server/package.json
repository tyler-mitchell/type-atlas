{
  "name": "@typeatlas/language-server",
  "version": "0.0.0",
  "description": "Volar-based TypeScript, Markdown, and JSON language server for TypeAtlas.",
  "keywords": [
    "json",
    "language-server",
    "lsp",
    "markdown",
    "typescript",
    "volar"
  ],
  "homepage": "https://github.com/tyler-mitchell/typeatlas/tree/main/packages/language-server",
  "bugs": {
    "url": "https://github.com/tyler-mitchell/typeatlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-mitchell/typeatlas.git",
    "directory": "packages/language-server"
  },
  "bin": {
    "typeatlas-language-server": "./bin/typeatlas-language-server.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./bin/typeatlas-language-server.cjs",
    "./dist/node.js",
    "./src/node.ts"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./protocol": {
      "development": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "default": "./dist/node.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "import": "./dist/protocol.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/node.ts src/protocol.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@volar/language-server": "catalog:",
    "typescript": "catalog:",
    "volar-service-json": "catalog:",
    "volar-service-markdown": "catalog:",
    "volar-service-typescript": "catalog:",
    "vscode-markdown-languageservice": "catalog:",
    "vscode-uri": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@volar/test-utils": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  }
}
