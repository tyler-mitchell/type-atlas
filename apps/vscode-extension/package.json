{
  "name": "featuretype-language-features",
  "version": "0.0.0",
  "private": true,
  "displayName": "FeatureType Language Features",
  "description": "First-class .featuretype authoring with embedded TSX diagnostics powered by Volar.js.",
  "publisher": "featuretype-local",
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onLanguage:featuretype"
  ],
  "contributes": {
    "languages": [
      {
        "id": "featuretype",
        "aliases": [
          "FeatureType",
          ".featuretype"
        ],
        "extensions": [
          ".featuretype"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "featuretype",
        "scopeName": "source.featuretype",
        "path": "./syntaxes/featuretype.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.tsx": "typescriptreact"
        }
      }
    ],
    "snippets": [
      {
        "language": "featuretype",
        "path": "./languages/featuretype.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "pnpm run bundle && pnpm run pack:vsix",
    "bundle": "tsx scripts/build.ts --minify",
    "watch": "tsx scripts/build.ts --watch",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pack": "pnpm run build",
    "pack:vsix": "rm -f dist/featuretype-language-features.vsix && vsce package --no-dependencies --out dist/featuretype-language-features.vsix",
    "test": "pnpm run build",
    "test:vscode": "pnpm run build && tsx scripts/runVscodeTests.ts"
  },
  "dependencies": {
    "@volar/language-server": "2.4.28",
    "@volar/vscode": "2.4.28",
    "vscode-languageclient": "^9.0.1",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.82.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.2",
    "vscode": "^1.1.37"
  }
}
