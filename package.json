{
  "name": "typeatlas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm lint && pnpm check-types && pnpm test",
    "check-types": "pnpm build && pnpm --recursive --if-present run check-types",
    "changeset": "changeset",
    "dev": "pnpm --filter @typeatlas/mcp run dev",
    "format": "oxlint --fix . && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "release": "pnpm check && changeset publish",
    "release:version": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile",
    "test": "pnpm --recursive --if-present run test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "pnpm@11.17.0"
}
