{
  "name": "type-atlas",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "changeset": "changeset",
    "check": "vp run lint && vp run check-types && vp run test",
    "check-types": "vp run build && vp run -r check-types",
    "check:changeset": "changeset status --since=origin/main",
    "check:distribution": "vp run build && vp node packages/mcp/scripts/verify-distribution.ts",
    "dev": "vp run @type-atlas/mcp#dev",
    "format": "vp lint --fix . && vp fmt .",
    "lint": "vp lint . && vp fmt --check .",
    "release": "vp run release:preflight && changeset publish",
    "release:preflight": "vp run check && vp node packages/mcp/scripts/verify-distribution.ts && changeset status",
    "release:status": "vp node scripts/release-status.ts",
    "release:version": "changeset version && vp node scripts/sync-server-manifest.ts && vp pm install --lockfile-only --no-frozen-lockfile",
    "test": "vp run -r test"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "execa": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "pnpm@11.17.0"
}
