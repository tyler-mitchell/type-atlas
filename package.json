{
  "name": "type-atlas",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm lint && pnpm check-types && pnpm test",
    "check:distribution": "pnpm build && node packages/mcp/scripts/verify-distribution.ts",
    "check-types": "pnpm build && pnpm --recursive --if-present run check-types",
    "changeset": "changeset",
    "dev": "pnpm --filter @type-atlas/mcp run dev",
    "format": "oxlint --fix . && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "release": "pnpm check && node packages/mcp/scripts/verify-distribution.ts && changeset publish",
    "release:version": "changeset version && node scripts/sync-server-manifest.ts && pnpm install --lockfile-only --no-frozen-lockfile",
    "test": "pnpm --recursive --if-present run test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "catalog:",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "pnpm@11.17.0"
}
